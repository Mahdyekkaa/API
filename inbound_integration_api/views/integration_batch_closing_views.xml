<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_integration_batch_closing_list" model="ir.ui.view">
        <field name="name">integration.batch.closing.list</field>
        <field name="model">integration.batch.closing</field>
        <field name="arch" type="xml">
            <list string="Batch Closings">
                <field name="batch_id"/>
                <field name="courier_name"/>
                <field name="courier_batch_number"/>
                <field name="status"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="ended_by"/>
                <field name="total_orders"/>
                <field name="net_due"/>
                <field name="total_received"/>
            </list>
        </field>
    </record>

    <record id="view_integration_batch_closing_form" model="ir.ui.view">
        <field name="name">integration.batch.closing.form</field>
        <field name="model">integration.batch.closing</field>
        <field name="arch" type="xml">
            <form string="Batch Closing">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_orders" type="object"
                                class="oe_stat_button" icon="fa-truck">
                            <field name="order_count" widget="statinfo" string="Orders"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="batch_id"/>
                        <h1>
                            <field name="batch_id" placeholder="Batch ID"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Batch">
                            <field name="courier_name"/>
                            <field name="courier_batch_number"/>
                            <field name="status"/>
                            <field name="ended_by"/>
                        </group>
                        <group string="Period">
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <group>
                        <group string="Order Summary">
                            <field name="total_orders"/>
                            <field name="delivered_collected"/>
                            <field name="to_be_reshipped"/>
                            <field name="amount_to_be_collected"/>
                        </group>
                        <group string="Financial">
                            <field name="base_commission"/>
                            <field name="additional"/>
                            <field name="bonus"/>
                            <field name="net_due"/>
                            <field name="total_received"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Orders" name="orders">
                            <field name="order_ids" nolabel="1">
                                <list>
                                    <field name="oid"/>
                                    <field name="consignee_id"/>
                                    <field name="consignee_phone"/>
                                    <field name="governorate"/>
                                    <field name="order_status" widget="badge"
                                           decoration-info="order_status == 'delivered'"
                                           decoration-warning="order_status == 'returned'"
                                           decoration-success="order_status == 'paid'"/>
                                    <field name="cod_collected" sum="Total"/>
                                    <field name="settlement_amount" sum="Total"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Transactions" name="transactions">
                            <field name="transaction_ids" nolabel="1">
                                <list editable="bottom">
                                    <field name="amount"/>
                                    <field name="method"/>
                                    <field name="image" widget="image" options="{'size': [64, 64]}"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_integration_batch_closing_search" model="ir.ui.view">
        <field name="name">integration.batch.closing.search</field>
        <field name="model">integration.batch.closing</field>
        <field name="arch" type="xml">
            <search string="Batch Closings">
                <field name="batch_id"/>
                <field name="courier_name"/>
                <field name="courier_batch_number"/>
                <field name="status"/>
                <field name="ended_by"/>
                <group expand="0" string="Group By">
                    <filter string="Courier" name="group_courier" context="{'group_by': 'courier_name'}"/>
                    <filter string="Status" name="group_status" context="{'group_by': 'status'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_integration_batch_closing" model="ir.actions.act_window">
        <field name="name">Batch Closings</field>
        <field name="res_model">integration.batch.closing</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_integration_batch_closing_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No batch closings yet
            </p>
            <p>
                Batches received from the inbound Batch Closing API appear here.
            </p>
        </field>
    </record>
</odoo>
