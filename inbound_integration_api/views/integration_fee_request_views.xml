<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_integration_fee_request_list" model="ir.ui.view">
        <field name="name">integration.fee.request.list</field>
        <field name="model">integration.fee.request</field>
        <field name="arch" type="xml">
            <list string="Fee Requests"
                  decoration-muted="state == 'draft'"
                  decoration-success="state == 'paid'">
                <field name="request_id"/>
                <field name="request_date"/>
                <field name="payment_date"/>
                <field name="order_count" string="Orders"/>
                <field name="delivered_amount" sum="Total"/>
                <field name="returned_fees" sum="Total"/>
                <field name="requested_amount" sum="Total"/>
                <field name="amount_to_transfer" sum="Total"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'requested'"
                       decoration-success="state == 'paid'"/>
            </list>
        </field>
    </record>

    <record id="view_integration_fee_request_form" model="ir.ui.view">
        <field name="name">integration.fee.request.form</field>
        <field name="model">integration.fee.request</field>
        <field name="arch" type="xml">
            <form string="Fee Request">
                <header>
                    <button name="action_request" type="object" string="Request"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_mark_paid" type="object" string="Mark as Paid"
                            class="btn-primary" invisible="state != 'requested'"
                            confirm="Mark this fee request and all its orders as Paid?"/>
                    <button name="action_reset_to_draft" type="object" string="Reset to Draft"
                            invisible="state != 'requested'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <div class="alert alert-warning mb-0" role="alert" invisible="not amount_mismatch">
                    Requested Amount does not match Amount to Transfer.
                </div>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_orders" type="object"
                                class="oe_stat_button" icon="fa-truck">
                            <field name="order_count" widget="statinfo" string="Orders"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="request_id"/>
                        <h1>
                            <field name="request_id" placeholder="Request ID"
                                   readonly="state == 'paid'"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Fee Breakdown">
                            <field name="currency_id" invisible="1"/>
                            <field name="delivered_amount"/>
                            <field name="returned_fees"/>
                            <field name="requested_amount" readonly="state == 'paid'"/>
                            <field name="amount_to_transfer" class="fw-bold"/>
                        </group>
                        <group string="Dates">
                            <field name="request_date" readonly="state == 'paid'"/>
                            <field name="payment_date" readonly="state == 'paid'"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Orders" name="orders">
                            <field name="order_ids" nolabel="1" widget="many2many"
                                   readonly="state != 'draft'"
                                   domain="[('fee_request_id', '=', False), ('delivery_outcome', '!=', False)]"
                                   context="{'create': False}">
                                <list>
                                    <field name="oid"/>
                                    <field name="num_products"/>
                                    <field name="subtotal" sum="Total"/>
                                    <field name="shipping_fees" sum="Total"/>
                                    <field name="total" sum="Total"/>
                                    <field name="order_type"/>
                                    <field name="delivery_outcome" widget="badge"
                                           decoration-info="delivery_outcome == 'delivered'"
                                           decoration-warning="delivery_outcome == 'returned'"/>
                                    <field name="date_delivered" string="Delivered/Returned At"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_integration_fee_request_search" model="ir.ui.view">
        <field name="name">integration.fee.request.search</field>
        <field name="model">integration.fee.request</field>
        <field name="arch" type="xml">
            <search string="Fee Requests">
                <field name="request_id"/>
                <field name="order_ids" string="Order OID"
                       filter_domain="[('order_ids.oid', 'ilike', self)]"/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Requested" name="requested" domain="[('state', '=', 'requested')]"/>
                <filter string="Paid" name="paid" domain="[('state', '=', 'paid')]"/>
                <group expand="0" string="Group By">
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Request Date" name="group_request_date"
                            context="{'group_by': 'request_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_integration_fee_request" model="ir.actions.act_window">
        <field name="name">Fee Requests</field>
        <field name="res_model">integration.fee.request</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_integration_fee_request_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No fee requests yet
            </p>
            <p>
                Group delivered and returned orders into a fee breakdown and track its payment.
            </p>
        </field>
    </record>
</odoo>
